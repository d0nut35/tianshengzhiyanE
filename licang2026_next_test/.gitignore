# Unused parts of the full CMSIS distribution. The project keeps only the
# STM32F750 device headers and the generic CMSIS headers required to compile.
Drivers/CMSIS/Core/
Drivers/CMSIS/Core_A/
Drivers/CMSIS/docs/
Drivers/CMSIS/DSP/
Drivers/CMSIS/Lib/
Drivers/CMSIS/NN/
Drivers/CMSIS/RTOS/
Drivers/CMSIS/RTOS2/
Drivers/CMSIS/Device/ST/STM32F7xx/Source/
Drivers/CMSIS/Device/ST/STM32F7xx/Include/*
!Drivers/CMSIS/Device/ST/STM32F7xx/Include/stm32f7xx.h
!Drivers/CMSIS/Device/ST/STM32F7xx/Include/stm32f750xx.h
!Drivers/CMSIS/Device/ST/STM32F7xx/Include/system_stm32f7xx.h

